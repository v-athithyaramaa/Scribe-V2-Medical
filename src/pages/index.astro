---
import Layout from '../layouts/Layout.astro';
import ScribeApp from '../components/ScribeApp.jsx';
---

<Layout>
  <nav class="bg-slate-900 border-b border-slate-800 text-white px-6 py-3">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
        <span class="font-bold text-sm tracking-wide">Medical AI Workspaces</span>
      </div>
      <div class="flex items-center space-x-2 text-xs">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-blue-600 text-white font-medium shadow-xs">
          ElevenLabs Scribe
        </a>
        <a href="/muse" class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 font-medium transition">
          Meta Muse Clinical Studio →
        </a>
      </div>
    </div>
  </nav>
	<main class="min-h-screen bg-slate-100 py-12">
		<ScribeApp client:load />
	</main>
</Layout>
